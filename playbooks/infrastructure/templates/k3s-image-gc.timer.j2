[Unit]
Description=Daily prune of unreferenced k3s/containerd images
Documentation=https://github.com/amerenda/ansible-playbooks

[Timer]
OnCalendar={{ k3s_image_gc_schedule }}
# Stagger across the fleet so every node doesn't hit containerd at once.
RandomizedDelaySec=600
# Catch up on the next boot if the node was down at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
