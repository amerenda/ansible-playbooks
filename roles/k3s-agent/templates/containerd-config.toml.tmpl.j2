# Ansible-managed override for k3s's embedded containerd (roles/k3s-agent).
# Base captured from k3s v1.33.5+k3s1 / containerd v2.1.4-k3s1's own generated
# config.toml -- k3s regenerates config.toml from this file on every agent
# start (see its own header in the generated file: "DO NOT EDIT. Use
# config.toml.tmpl instead.").
#
# Only deployed when k3s_agent_containerd_meta_ssd_dir is set (see
# roles/k3s-agent/defaults/main.yml). Two deliberate deviations from what k3s
# would generate by default:
#
#   1. [grpc] max_recv_message_size / max_send_message_size raised to 64MiB --
#      guards against a CRI ListPodSandbox response exceeding the 16MiB gRPC
#      default once a lot of sandbox records accumulate. This alone does not
#      fix an already-bloated meta.db (kubelet's own CRI client has a
#      separate, non-configurable 16MiB cap on stock Kubernetes) -- it's a
#      second line of defense, not a substitute for keeping sandbox count
#      bounded.
#   2. meta.db lives under k3s_agent_containerd_meta_ssd_dir instead of under
#      this host's data-dir volume (symlinked there by tasks/main.yml) --
#      boltdb's random small-page I/O pattern is a bad fit for spinning-disk
#      RAID throughput.
#
# Root cause background: 2026-09-08 murderbot NotReady incident -- a leaked
# sandbox count (from crash-looping ARC ephemeral runner pods) combined with
# meta.db sitting on a mediocre-throughput RAID5 array to produce a containerd
# boot that took 5+ minutes, then hung again on the CRI's 16MiB cap once it
# did come up.
#
# This template currently assumes an NVIDIA GPU host (see the 'nvidia'
# runtime block below) since murderbot is the only host using the SSD split
# today. If a future non-NVIDIA host needs this same split, parameterize the
# runtime block rather than copy-pasting this file.
#
# If a k3s upgrade changes what it generates by default, diff this against a
# freshly generated config.toml on an unaffected host and re-sync the
# non-grpc, non-path sections here.

version = 3
root = "{{ k3s_agent_data_dir }}/agent/containerd"
state = "/run/k3s/containerd"

[grpc]
  address = "/run/k3s/containerd/containerd.sock"
  max_recv_message_size = 67108864
  max_send_message_size = 67108864

[plugins.'io.containerd.internal.v1.opt']
  path = "{{ k3s_agent_data_dir }}/agent/containerd"

[plugins.'io.containerd.grpc.v1.cri']
  stream_server_address = "127.0.0.1"
  stream_server_port = "10010"

[plugins.'io.containerd.cri.v1.runtime']
  enable_selinux = false
  enable_unprivileged_ports = true
  enable_unprivileged_icmp = true
  device_ownership_from_security_context = false

[plugins.'io.containerd.cri.v1.images']
  snapshotter = "overlayfs"
  disable_snapshot_annotations = true
  use_local_image_pull = true

[plugins.'io.containerd.cri.v1.images'.pinned_images]
  sandbox = "rancher/mirrored-pause:3.6"

[plugins.'io.containerd.cri.v1.runtime'.cni]
  # Intentionally NOT under data-dir -- k3s always extracts CNI binaries to
  # this fixed default-data-dir path regardless of the data-dir setting.
  bin_dirs = ["/var/lib/rancher/k3s/data/cni"]
  conf_dir = "{{ k3s_agent_data_dir }}/agent/etc/cni/net.d"

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc]
  runtime_type = "io.containerd.runc.v2"

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc.options]
  SystemdCgroup = true

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runhcs-wcow-process]
  runtime_type = "io.containerd.runhcs.v1"

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.'nvidia']
  runtime_type = "io.containerd.runc.v2"

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.'nvidia'.options]
  BinaryName = "/usr/bin/nvidia-container-runtime"
  SystemdCgroup = true

[plugins.'io.containerd.cri.v1.images'.registry]
  config_path = "{{ k3s_agent_data_dir }}/agent/etc/containerd/certs.d"
