# k3s Agent Configuration
# Managed by Ansible (roles/k3s-agent) — manual edits will be overwritten.

server: "{{ cachyos_k3s_server }}"
token: "{{ hostvars['localhost']['k3s_token'] }}"

node-name: "{{ cachyos_k3s_node_name }}"
node-ip: "{{ cachyos_k3s_node_ip }}"

data-dir: "{{ k3s_agent_data_dir }}"
log: "/var/log/k3s-agent.log"

{% if k3s_agent_kubelet_args | length > 0 %}
kubelet-arg:
{% for arg in k3s_agent_kubelet_args %}
  - "{{ arg }}"
{% endfor %}
{% endif %}

{% if k3s_agent_node_labels | length > 0 %}
node-label:
{% for label in k3s_agent_node_labels %}
  - "{{ label }}"
{% endfor %}
{% endif %}
