#!/usr/bin/env bash
# dpms-sleep-fix.sh (deployed by roles/kde-plasma)
#
# Workaround for a confirmed KDE/powerdevil bug on this box's dual-output
# (desk monitor + couch TV) setup: after DPMS turns the display off on idle,
# powerdevil runs its own display re-detection cycle a few seconds later
# ("There are no outputs - creating placeholder screen" in the powerdevil
# log), which resets brightness via the KWin backend and wakes the display
# back up -- so the screen never actually stays asleep.
#
# Two other pieces are required for this to work and are deployed alongside
# it (see tasks/main.yml):
#   - plasma-powerdevil.service.d/debug-logging.conf: this script detects
#     the trigger by grepping powerdevil's own log for "DPMS: triggered on
#     idle timeout", which is only logged with debug logging enabled.
#   - plasma-powerdevil.service.d/no-ddcutil.conf: disables ddcutil, which
#     is one confirmed trigger of the same underlying bug
#     (recently_resumed_from_sleep_by_clocktime false-positive).
#
# Confirmed via testing: the redetection can fire MORE THAN ONCE per
# idle-off event (observed bursts at both +5s and +20s in the same cycle),
# so a single corrective re-assert is not reliable. This sustains correction
# for 60s after the trigger, checking every 5s.
export XDG_RUNTIME_DIR=/run/user/{{ cachyos_user_uid }}
export WAYLAND_DISPLAY=wayland-0
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{{ cachyos_user_uid }}/bus

LOG=/tmp/dpms-sleep-fix.log
DESK_DPMS_PATH=/sys/class/drm/{{ dpms_sleep_fix_drm_card }}-{{ dpms_sleep_fix_desk_connector }}/dpms

journalctl --user -u plasma-powerdevil.service -f -n0 2>/dev/null | while IFS= read -r line; do
    if [[ "$line" == *"DPMS: triggered on idle timeout"* ]]; then
        echo "$(date -Is) idle-off trigger seen, enforcing for 60s" >> "$LOG"
        end=$(( $(date +%s) + 60 ))
        while [ "$(date +%s)" -lt "$end" ]; do
            sleep 5
            state=$(cat "$DESK_DPMS_PATH" 2>/dev/null)
            if [ "$state" != "Off" ]; then
                echo "$(date -Is) state=$state, correcting" >> "$LOG"
                kscreen-doctor --dpms off >/dev/null 2>&1
            fi
        done
        echo "$(date -Is) enforcement window done" >> "$LOG"
    fi
done
